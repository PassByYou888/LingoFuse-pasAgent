object llm_tool_form: Tllm_tool_form
  Left = 315
  Height = 400
  Top = 250
  Width = 770
  Caption = 'LLM本地工具'
  ClientHeight = 400
  ClientWidth = 770
  Constraints.MinHeight = 400
  Constraints.MinWidth = 770
  Position = poMainFormCenter
  LCLVersion = '4.8.0.0'
  OnClose = FormClose
  object PageControl: TPageControl
    Left = 0
    Height = 400
    Top = 0
    Width = 770
    ActivePage = LLM_Opt_TabSheet
    Align = alClient
    TabIndex = 0
    TabOrder = 0
    object LLM_Opt_TabSheet: TTabSheet
      Caption = 'LLM参数'
      ClientHeight = 370
      ClientWidth = 762
      object Label4: TLabel
        Left = 24
        Height = 17
        Top = 8
        Width = 411
        Caption = '本地高速大语言模型.无需联网,不消耗显存.主要负责,代码声明体环节互相转换.'
      end
      object sys_prompt_Memo: TMemo
        Left = 24
        Height = 168
        Top = 144
        Width = 720
        Anchors = [akTop, akLeft, akRight, akBottom]
        Lines.Strings = (
          '你是一个代码声明转换助手，专注于在不同编程语言之间进行程序声明级别的转换。'
          ''
          '**主要任务**  '
          '根据用户的指令，将一段用源语言编写的声明代码转换为目标语言的等价声明代码。'
          ''
          '**转换规则**  '
          '- 只转换声明部分，忽略函数体、方法实现或任何可执行语句。如果输入包含完整函数，仅转换其签名（返回类型、函数名、参数列表等），并保留函数体为空（或适当占位符）。  '
          '- 保持原始声明的语义不变，包括类型、名称、修饰符（如const、static、public等）在目标语言中的对应形式。  '
          '- 如果目标语言没有直接对应的特性，请采用最接近的惯用表达，并在必要时以注释说明差异。  '
          '- 保留输入中的注释，将其放置在适当位置。  '
          '- 遵循目标语言的命名惯例和格式规范（如缩进、括号风格）。  '
          ''
          '**问答模式**  '
          '如果用户的问题不是代码转换请求（例如询问“如何在Pascal中声明指针？”或“C#的接口和抽象类有什么区别？”），请以简洁、清晰的语言回答，并提供相关声明示例'
          ''
          '**输出要求** '
          '- 对于转换请求，只输出转换后的代码块，不要添加额外解释，除非用户要求'
          '- 如果转换无法完成或存在歧义，输出错误提示或说明，并尽量给出部分转换结果。 '
          '- 全部以text格式输出，禁止使用markdown格式'
          '- 禁止使用一切emoji符号'
          '- 单行不要过长，字符数量最好不要超过80'
          '- 单行中文字符最长80'
          '- 在问答模式下，直接回答问题，可包含代码示例'
        )
        ScrollBars = ssAutoBoth
        TabOrder = 0
      end
      object Label1: TLabel
        Left = 24
        Height = 17
        Top = 112
        Width = 111
        BidiMode = bdRightToLeft
        Caption = '系统提示词,工作原则'
        ParentBidiMode = False
      end
