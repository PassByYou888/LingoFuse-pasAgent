        MouseSelActions = <>
        Lines.Strings = (
          '欢迎使用 Pascal → MCP 工具提供者代码生成器'
          '本工具将任意编程语言（Pascal、C、Python、JavaScript 等）中的函数/过程'
          '声明，自动转换为可直接部署的 LingoFuse 工具提供者，使其能够被 MCP 客户端调用。'
          ''
          '核心架构：3层透明转换模型, 每一层均可独立查看、编辑和导出，完全透明元数据流水线'
          '  Layer 0   : 原始代码（Pascal / C / Python / JavaScript 等）'
          '              ↓ 通过“代码修饰器模型”统一转换为：'
          '  Layer 1   : Pascal 声明体（文本形态，标准 Pascal 语法）'
          '              ⇄ 可双向转换'
          '  Layer 2   : 底层数据结构（LV0）'
          '              └─ 由 Z.Pascal_Func_Tool 解析生成，包含 tfunc_decl 原始记录'
          '              └─ 可导出为 LV0 JSON，供外部编辑修正解析错误'
          '              ↓'
          '  Layer 3   : 中间数据结构（LV1）'
          '              └─ 由 pascal_func_model 将 LV0 数据规范化：'
          '                  · 类型归一化（Integer→Int64, Double→Double, String→string）'
          '                  · 参数描述提取（从注释解析 @param、:、= 等格式）'
          '                  · 合并注释，生成结构化元数据（TFunctionStructure）'
          '              └─ 可导出为 LV1 JSON，供外部调整参数描述、类型映射等'
          '              ↓'
          '  Layer 4   : 目标代码生成器（pas_mcp_generator_tool）'
          '              └─ 基于 LV1 结构体生成完整的 LingoFuse 工具提供者程序'
          '              └─ 可扩展生成 Python、JavaScript 等其他语言的接口代码'
          ''
          '透明性说明'
          '- 每一层（LV0、LV1）均有对应的 JSON 表示，您可以直接编辑这些 JSON 文件'
          '  来修正元数据，而无需修改原始源代码或重新解析。'
          '- 编辑后的 JSON 可重新导入，驱动后续流程。'
          '- 目标代码生成器可根据 LV1 结构体生成多种输出格式，实现“一次建模，'
          '  多目标输出”。'
          ''
          '当前工具的工作流程'
          '1. 在“源代码”编辑框中输入您的函数声明（目前支持 Pascal 语法，未来可'
          '   扩展其他语言）。'
          '2. 点击“解析”按钮：'
          '   - 内部调用 Z.Pascal_Func_Tool 生成 LV0 底层结构体。'
          '   - 自动将 LV0 传递给 pascal_func_model 生成 LV1 中间结构体。'
          '3. （可选）查看并修改 LV1 JSON（在工具中可直接编辑）。'
          '4. 点击“生成代码”：'
          '   - 调用 pas_mcp_generator_tool 基于 LV1 生成完整的'
          '     <UnitName>_tool_provider.pas。'
          '   - 生成的程序可直接编译运行，向 MCP 网关注册所有工具。'
          '5. 编译并运行生成的程序，您的函数即成为 MCP 可调用的远程 API。'
          ''
          '未来扩展'
          '- 为其他语言编写“代码修饰器”，将其函数声明转换为 Pascal 声明体，'
          '  即可复用后续所有流程。'
          '- 调整目标代码生成器，输出不同语言（如 Python、JavaScript）的'
          '  LingoFuse 服务端代码。'
          ''
          '开始使用'
          '- 左侧“源代码”面板：粘贴您的代码（目前支持 Pascal）。'
          '- 右侧“LLM 助手”面板（可选）：连接 LLM 服务，辅助优化注释或生成'
          '  参数描述。'
          '- 点击“生成”按钮，工具将自动执行全流程，生成的代码将显示在下方'
          '  SSE 区域。'
          ''
          '如有疑问，请查阅项目文档或联系开发团队。'
          ''
          '祝您使用愉快！'
        )
        Options = [eoAutoIndent, eoBracketHighlight, eoGroupUndo, eoScrollPastEol, eoSmartTabs, eoTabIndent, eoTabsToSpaces, eoTrimTrailingSpaces]
        VisibleSpecialChars = [vscSpace, vscTabAtLast]
        RightEdge = 160
